  m_EditorClassIdentifier: 
  text: "\u041F\u0420\u041E\u0426\u0415\u0421\u0421 \u0423\u0421\u041F\u0415\u0428\u041D\u041E
    \u0410\u041A\u0422\u0418\u0412\u0418\u0420\u041E\u0412\u0410\u041D.\n\u0414\u043E\u0431\u0440\u043E
    \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C, \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C.\n\u0412\u044B
    \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043B\u0438\u0441\u044C
    \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0439
    \u0431\u0430\u0437\u044B \u0438 \u0435\u0449\u0435 \u043D\u0435 \u0437\u043D\u0430\u0435\u0442\u0435,
    \u043A\u0430\u043A \u0441 \u043D\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C?
    \u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u043D\u0430\u0448 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0430\u0436
    \u043F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441!"
