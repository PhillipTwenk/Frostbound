  m_text: "\u0418 \u0432\u0435\u0441\u044C \u043F\u0440\u043E\u0435\u043A\u0442,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u0442\u0440\u043E\u0438\u043B\u0441\u044F
    \u0433\u043E\u0434\u0430\u043C\u0438 \u043D\u0430 \u043E\u0440\u0431\u0438\u0442\u0435
    \u0426\u0435\u0442\u043E\u0441\u0430, \u043D\u0430\u0447\u0430\u043B \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043B\u0435\u0442\u0435\u0442\u044C \u043D\u0430 \u0437\u0435\u043C\u043B\u044E.
    \u0418\u0437 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F \u043D\u0430 \u0441\u043F\u0430\u0441\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043A\u0430\u043F\u0441\u0443\u043B\u0430\u0445 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
    \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439 \u0443\u043B\u0435\u0442\u0435\u043B\u043E,
    \u0438 \u043B\u0438\u0448\u044C \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441 \u0410\u043B\u0435\u043A\u0441\u0435\u0435\u043C."
