      m_Calls: []
  m_text: "\"\u042F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E \u0441\u0432\u043E\u0438
    \u0448\u0442\u0443\u043A\u0438 \u043D\u0430 \u0432\u0430\u0448\u0435 \u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435,
    \u0438 \u043C\u044B \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0435\u043C \u044D\u0442\u043E
    \u0432\u0441\u0435 \u043D\u0430 \u0431\u043E\u043B\u0435\u0435 \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u043D\u0443\u044E
    \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C!\"\r\n-\"\u041F\u043E\u0447\u0435\u043C\u0443
    \u043C\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0432\u0435\u0440\u0438\u0442\u044C
    \u0442\u0435\u0431\u0435? \u0414\u0430 \u0442\u044B \u043B\u0438\u0448\u044C
    \u043D\u0438\u043A\u0447\u0435\u043C\u043D\u044B\u0439 \u043F\u0435\u0440\u0432\u043E\u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u0435\u043B\u044C,
    \u0447\u0442\u043E \u0442\u044B \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0434\u0435\u043B\u0430\u0442\u044C?
    \u0423\u0445\u043E\u0434\u0438 \u043E\u0442\u0441\u044E\u0434\u0430, \u0448\u0443\u0442\u043D\u0438\u043A.\""
  m_isRightToLeft: 0
