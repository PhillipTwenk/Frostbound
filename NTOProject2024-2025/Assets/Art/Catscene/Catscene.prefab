  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041E\u043D \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u043E\u0431 \u044D\u0442\u043E\u043C \u0441\u0432\u043E\u0435\u043C\u0443 \u0434\u0440\u0443\u0433\u0443
    \u0413\u0435\u043E\u0440\u0433\u0438\u044E \u041A\u043E\u0440\u043E\u043B\u0451\u0432\u0443
    - \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0443.\r\n-\"\u042D\u0442\u043E
    \u043D\u043E\u0432\u044B\u0435 \u0434\u0435\u0442\u0430\u043B\u0438 \u0434\u043B\u044F
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u043F\u043E \u0431\u0435\u0440\u043B\u043E\u0433\u043E\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044E
    \u0426\u0435\u0442\u043E\u0441\u0430. \u042D\u0442\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0430
    - \u043F\u0440\u043E\u0441\u0442\u043E \u0436\u0443\u0442\u044C \u043A\u0430\u043A\u0430\u044F
    \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F, \u043D\u0438\u043A\u043E\u0433\u0434\u0430
    \u0442\u0443\u0434\u0430 \u043D\u0435 \u043F\u043E\u043B\u0435\u0447\u0443. \u041D\u043E
    \u0440\u0430\u0437 \u0443\u0436 \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C
    \u0438\u0445 \u0432\u0437\u044F\u0442\u044C \u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0442\u0443\u0434\u0430, \u0442\u043E \u0434\u0430\u044E \u0444\u043B\u0430\u0433
    \u0432 \u0440\u0443\u043A\u0438!\""
