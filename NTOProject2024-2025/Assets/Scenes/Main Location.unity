  ButtonUpgradeTextPanel: {fileID: 98287087}
  TextNotEnoughtResources: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
    \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0434\u043B\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
    \u0437\u0434\u0430\u043D\u0438\u044F"
  TextNotEnoughtBaseLevel: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u044B\u0439
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043C\u043E\u0431\u0438\u043B\u044C\u043E\u0439
    \u0431\u0430\u0437\u044B \u0434\u043B\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
    \u0437\u0434\u0430\u043D\u0438\u044F "
  UpgradeLevelBuildingInformation: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C \u0437\u0434\u0430\u043D\u0438\u044F
    \u043F\u043E\u0432\u044B\u0448\u0435\u043D !"
  TextNotCompleteConditionUpgradeMB: "\u0414\u043B\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
    \u0431\u0430\u0437\u044B \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F"
  TextCompleteUpgradeMobileBaseLevel: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C
    \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0439 \u0431\u0430\u0437\u044B
    \u043F\u043E\u0432\u044B\u0448\u0435\u043D"
  TextLimitResourcesIron: "\u0414\u043E\u0431\u044B\u0432\u0430\u044E\u0449\u0438\u0435
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u044B,
    \u043F\u0440\u0435\u0432\u044B\u0448\u0435\u043D \u043B\u0438\u043C\u0438\u0442
    \u043C\u0435\u0442\u0430\u043B\u043B\u0430 "
