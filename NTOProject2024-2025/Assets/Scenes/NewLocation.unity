  m_text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0412\u044B \u043E\u0441\u0432\u043E\u0438\u043B\u0438
    \u0431\u0430\u0437\u043E\u0432\u044B\u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u0438
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u043F\u043E \u0431\u0435\u0440\u043B\u043E\u0433\u043E\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044E
    \u043F\u043B\u0430\u043D\u0435\u0442\u044B \"\u0426\u0435\u0442\u043E\u0441\".
    \u041F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0432\u044B
    \u0443\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u0443\u0435\u0442\u0435
    \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u0443\u044E \u0431\u0430\u0437\u0443
    \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u0441\u0442\u0430\u0434\u0438\u0438
    \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u0432\u0441\u0435
    \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F,
    \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0431\u0435\u0440\u043B\u043E\u0433\u043E\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F.
    \u0420\u0430\u0437\u0432\u0438\u0432\u0430\u0439\u0442\u0435 \u0441\u0432\u043E\u044E
    \u0431\u0430\u0437\u0443 \u0438 \u0438\u0437\u0443\u0447\u0438\u0442\u0435 \u0432\u0441\u0435
    \u0431\u043B\u0438\u0437\u043B\u0435\u0436\u0430\u0449\u0438\u0435 \u043B\u043E\u043A\u0430\u0446\u0438\u0438
